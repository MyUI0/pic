#!name=Heaizo 自动登录签到
#!desc=捕获成功登录完整请求，定时自动登录获取新 Token 后签到。签名被服务端拒绝时需从 Telegram 重新打开，不保证永久无人值守。
#!date=2026-10-20
#!author=AutoScript / local repair
#!icon=https://chatclient.heaizo.com/favicon.ico
#!loon_version=3.2.4(787)

[Argument]
arg1 = switch,true,tag=启用每日签到
arg2 = switch,true,tag=捕获成功登录凭证
arg3 = input,"0 8 * * *",tag=签到时间

[Script]
cron {arg3} script-path=https://raw.githubusercontent.com/MyUI0/pic/main/TGAI.js, timeout=40, enable={arg1}, tag=Heaizo自动登录签到
http-response ^https://chatclient\.heaizo\.com/user/login/fast/login(?:\?.*)?$ script-path=https://raw.githubusercontent.com/MyUI0/pic/main/TGAI.js, requires-body=true, timeout=10, enable={arg2}, tag=Heaizo捕获成功登录

[MITM]
hostname = chatclient.heaizo.com
