
#!name=酷云自动签到
#!desc=酷云/酷卡签到与积分任务；源码确认refreshToken优先刷新，普通密码后备默认关闭，需本地自愿填写
#!date=2026-10-17
#!author=AutoScript
#!icon=https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/kuyun.png
#!loon_version=3.5.1(983)

[Argument]
arg1 = switch,true,tag=启用每日签到
arg2 = switch,false,tag=自动抓包更新登录凭证
arg3 = input,"5 9 * * *",tag=签到时间
autoLogin = switch,false,tag=密码登录后备,desc=刷新不可用或明确失效时才尝试一次；启用表示同意登录协议；参数明文勿分享
mobile = input,"",type=string,tag=登录账号,desc=仅本地手填 不从抓包读取
password = input,"",type=string,tag=普通登录密码,desc=源码仅去除首尾空白 不做MD5；旧API密码值请清空重填；明文勿分享

[Script]
cron ${arg3} then script("https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/kuyun.js", {${autoLogin}, ${mobile}, ${password}}) with timeout=240, enable=${arg1}, tag="酷云每日签到"
request if ${url} ~= /^https:\/\/zuhu\.kuka001\.com\/(?:market|api)\// then script("https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/kuyun.js") with requires_body=false, timeout=10, enable=${arg2}, tag="酷云自动抓包更新凭证"
response if ${url} ~= /^https:\/\/zuhu\.kuka001\.com\/api\/login\/userSess(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/kuyun.js") with requires_body=true, timeout=10, enable=${arg2}, tag="酷云登录响应更新凭证"

[MITM]
hostname = zuhu.kuka001.com
