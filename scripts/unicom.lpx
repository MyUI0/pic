#!name=中国联通 每日签到
#!desc=中国联通自动化：插件页填写 Token#AppId，也可开启抓包自动更新长期凭证；支持资产查询、每日签到、月签有礼、任务中心、话费红包，多账号支持。
#!date=2026-08-21
#!author=converted by 也也
#!homepage=https://github.com/wangye528/china-unicom-surge
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/China_Unicom.png
#!loon_version=3.2.4(787)

[Argument]
arg1 = switch,true,tag=启用每日签到
arg2 = switch,true,tag=自动抓包更新 Token#AppId
arg3 = input,"placeholder",tag=Token#AppId，多账号用 & 分隔；留 placeholder 可使用抓包保存值
arg4 = input,"0 8 * * *",tag=签到时间 Cron
arg5 = select,"daily","daily","query",tag=运行模式

[Script]
cron {arg4} script-path=https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/unicom.js, argument={arg3}|{arg4}|{arg5}, timeout=180, enable={arg1}, tag=中国联通每日签到
http-request ^https?:\/\/m\.client\.10010\.com\/mobileService\/onLine\.htm script-path=https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/unicom.js, requires-body=true, timeout=10, enable={arg2}, tag=中国联通自动抓包更新Token

[MITM]
hostname = m.client.10010.com
