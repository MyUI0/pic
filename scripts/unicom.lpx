#!name=中国联通 每日签到
#!desc=中国联通自动化：自动抓包保存 Token#AppId，单账号覆盖模式，定时读取已保存凭证执行签到；抓取和签到开关分离。
#!date=2026-08-22
#!author=converted by 也也
#!homepage=https://github.com/wangye528/china-unicom-surge
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/China_Unicom.png
#!loon_version=3.2.4(787)

[Argument]
arg1 = switch,true,tag=启用每日签到
arg2 = switch,true,tag=自动抓包更新 Token#AppId
arg3 = input,"0 8 * * *",tag=签到时间

[Script]
cron {arg3} script-path=https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/unicom.js, timeout=180, enable={arg1}, tag=中国联通每日签到
http-request ^https?:\/\/m\.client\.10010\.com\/.* script-path=https://raw.githubusercontent.com/MyUI0/pic/refs/heads/main/scripts/unicom.js, requires-body=true, timeout=10, enable={arg2}, tag=中国联通自动抓包更新Token

[MITM]
hostname = m.client.10010.com
